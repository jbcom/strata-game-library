{
  "name": "@strata-game-library/core",
  "version": "1.7.0",
  "description": "Renderer-free TypeScript for procedural 3D games: terrain, physics, pathfinding, ECS, animation, audio, input, maze generation and rendering effects.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shaders": {
      "types": "./dist/shaders/index.d.ts",
      "import": "./dist/shaders/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./game": {
      "types": "./dist/game/index.d.ts",
      "import": "./dist/game/index.js"
    },
    "./compose": {
      "types": "./dist/compose/index.d.ts",
      "import": "./dist/compose/index.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "import": "./dist/world/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/animation": {
      "types": "./dist/core/animation/index.d.ts",
      "import": "./dist/core/animation/index.js"
    },
    "./core/audio": {
      "types": "./dist/core/audio/index.d.ts",
      "import": "./dist/core/audio/index.js"
    },
    "./core/camera": {
      "types": "./dist/core/camera/index.d.ts",
      "import": "./dist/core/camera/index.js"
    },
    "./core/ecs": {
      "types": "./dist/core/ecs/index.d.ts",
      "import": "./dist/core/ecs/index.js"
    },
    "./core/input": {
      "types": "./dist/core/input/index.d.ts",
      "import": "./dist/core/input/index.js"
    },
    "./core/math": {
      "types": "./dist/core/math/index.d.ts",
      "import": "./dist/core/math/index.js"
    },
    "./core/maze": {
      "types": "./dist/core/maze/index.d.ts",
      "import": "./dist/core/maze/index.js"
    },
    "./core/particles": {
      "types": "./dist/core/particles/index.d.ts",
      "import": "./dist/core/particles/index.js"
    },
    "./core/pathfinding": {
      "types": "./dist/core/pathfinding/index.d.ts",
      "import": "./dist/core/pathfinding/index.js"
    },
    "./core/physics": {
      "types": "./dist/core/physics/index.d.ts",
      "import": "./dist/core/physics/index.js"
    },
    "./core/rendering": {
      "types": "./dist/core/rendering/index.d.ts",
      "import": "./dist/core/rendering/index.js"
    },
    "./core/shared": {
      "types": "./dist/core/shared/index.d.ts",
      "import": "./dist/core/shared/index.js"
    },
    "./core/state": {
      "types": "./dist/core/state/index.d.ts",
      "import": "./dist/core/state/index.js"
    },
    "./core/terrain": {
      "types": "./dist/core/terrain/index.d.ts",
      "import": "./dist/core/terrain/index.js"
    },
    "./core/ui": {
      "types": "./dist/core/ui/index.d.ts",
      "import": "./dist/core/ui/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/ tests/",
    "format:check": "biome format src/ tests/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "test": "vitest run",
    "test:unit": "vitest run --config tests/unit/vitest.config.ts",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run test:unit"
  },
  "keywords": [
    "strata",
    "3d-graphics",
    "procedural-generation",
    "algorithms",
    "sdf",
    "marching-cubes",
    "gpu-instancing",
    "raymarching",
    "volumetric",
    "terrain",
    "water",
    "ecs",
    "pathfinding",
    "physics",
    "animation"
  ],
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/strata-game-library.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jbcom/strata-game-library/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/jbcom/strata-game-library/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "three": ">=0.150.0",
    "yuka": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "yuka": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "@strata-game-library/shaders": "workspace:*",
    "@types/howler": "^2.2.12",
    "howler": "^2.2.4",
    "immer": "^11.1.4",
    "maath": "^0.10.8",
    "miniplex": "^2.0.0",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1",
    "seedrandom": "^3.0.5",
    "simplex-noise": "^4.0.3",
    "xstate": "^5.28.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/howler": "^2.2.12",
    "@types/node": "^25.5.0",
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.183.1",
    "@types/yuka": "^0.7.4",
    "@vitest/coverage-v8": "^4.1.10",
    "glob": "^13.0.6",
    "howler": "^2.2.4",
    "jsdom": "^29.1.1",
    "miniplex": "^2.0.0",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1",
    "rimraf": "^6.1.3",
    "simplex-noise": "^4.0.3",
    "three": "^0.183.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "xstate": "^5.28.0",
    "yuka": "^0.7.8",
    "@strata-game-library/vite": "workspace:*"
  }
}
