{
  "name": "@strata-game-library/examples",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "pnpm run verify",
    "lint": "pnpm run verify",
    "test": "pnpm run verify && pnpm run test:e2e",
    "test:e2e": "playwright test --project=chromium",
