    "@react-three/postprocessing": "^3.1.0",
    "@react-three/rapier": "^2.2.0",
    "leva": "^0.10.1",
    "postprocessing": "^6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "strata-game-library": "workspace:*",
    "three": "^0.185.1",
    "yuka": "^0.7.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
