# Make the `engines` field in package.json a hard failure, not a warning.
#
# Without this, `pnpm install` only WARNS on a toolchain mismatch, which defeats
# the reason the pins exist:
#   - Node >=24 leaves `localStorage` undefined unless --localstorage-file is
#     passed, so jsdom declines to provision it and 25 packages/core tests fail
#     with an error that never mentions Node.
#   - pnpm >=11 silently stops reading the `pnpm` field of package.json, which
#     would drop the security overrides below with no warning at all.
#
# Both failure modes are silent by nature; engine-strict makes them loud at
# install time instead.
engine-strict=true
