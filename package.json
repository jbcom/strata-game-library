{
  "name": "@strata-game-library/monorepo",
  "private": true,
  "description": "Strata Game Library - monorepo for procedural 3D graphics and game framework",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:serial": "nx run-many -t test --parallel=1",
    "test:unit": "nx run-many -t test:unit",
    "test:integration": "nx run-many -t test:integration",
    "test:e2e": "nx run-many -t test:e2e",
    "test:coverage": "nx run-many -t test:coverage",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "format": "pnpm -r --if-present run format",
    "format:check": "pnpm -r --if-present run format:check",
    "typecheck": "nx run-many -t typecheck",
    "api:report": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs",
    "api:check": "node scripts/api-report.mjs --check && node scripts/api-report.mjs --check-exports-map",
    "docs": "pnpm run docs:dev",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "docs:build:pages": "pnpm run docs:build",
    "docs:links": "node scripts/check-links.mjs docs/dist",
    "package:inspect": "node scripts/validate-packages.mjs",
    "package:validate": "pnpm run build && pnpm run package:inspect",
    "release:validate": "pnpm run lint && pnpm run typecheck && pnpm run test:serial && pnpm run package:inspect && pnpm run docs:build && pnpm run docs:links",
    "publish:ci": "node scripts/publish-workspace.mjs",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "graph": "nx graph",
    "docs:api": "typedoc --options typedoc.json",
    "docs:internal": "typedoc --options typedoc.internal.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "{packages,adapters,plugins}/*/src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "{packages,adapters,plugins}/*/src/**/*.{json,md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/strata-game-library.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@nx/js": "23.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "23.1.1",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3"
  }
}
